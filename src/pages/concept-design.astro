---
import PageLayout from '../layouts/PageLayout.astro';
import PageHero from '../components/ui/PageHero.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import ProjectGallery from '../components/project/ProjectGallery.astro';
import InteriorGallery from '../components/project/InteriorGallery.astro';
import ProjectSpecifications from '../components/project/ProjectSpecifications.astro';
import FloorPlanExplorer from '../components/concept/FloorPlanExplorer.astro';
import CTASection from '../components/ui/CTASection.astro';
import { allApartmentConfigurations } from '../data/floorPlans';
import { conceptStudio, conceptProjects } from '../data/conceptDesign';

const ongoing = conceptProjects.filter((p) => p.status === 'Ongoing').length;
const completed = conceptProjects.filter((p) => p.status === 'Completed').length;


const factsheet = [
  { label: 'Urban Address', title: 'Bendoorwell, Mangaluru', text: 'Direct access from existing 9.00M and proposed 6.00M wide municipal roads, situated within minutes of PVS Junction and central city conveniences.' },
  { label: 'Exclusive Density', title: '22 Residential Apartments', text: 'An intimate enclave with only 4 residences per typical floor, eliminating shared common living walls and providing unparalleled residential privacy.' },
  { label: 'Building Structure', title: 'Ground + 4 Upper Floors', text: 'Low-rise contemporary architecture engineered with robust RCC framework, cantilevered balconies, and a finished rooftop terrace with pergola canopy.' },
  { label: 'Dedicated Parking', title: 'Subterranean Basement', text: 'Dedicated basement parking garage with numbered bays, gentle vehicular entry/exit ramps, wide driveways, and direct lift core access.' },
  { label: 'Vertical Mobility', title: '8-Passenger Automated Lift', text: '1 automated high-speed elevator with automatic rescue device (ARD), connecting basement parking through all residential upper floors.' },
  { label: 'Power & Utilities', title: 'Dual Water & Standby Generator', text: 'Dual water supply via Borewell + Corporation connection, rainwater harvesting, reticulated gas line, and soundproof generator backup.' },
];

const units = [
  { type: '2 BHK', floor: 'Ground Floor', meta: 'Unit 001, Ground Level', area: '1034 sq. ft.', img: '/images/floor-plans/ground-unit-001.webp', w: 920, h: 860, alt: '2 BHK 1034 sq. ft. Floor Plan',
    text: 'Living lounge (14\'6"x10\'0"), dining (9\'0"x12\'6"), kitchen with 4\'0" utility, master bedroom (10\'0"x13\'0") with attached bath, and second bedroom.' },
  { type: '2 BHK', floor: '1st - 4th Floors', meta: 'Unit 004, Typical Level', area: '1084 sq. ft.', img: '/images/floor-plans/typical-unit-004.webp', w: 850, h: 750, alt: '2 BHK 1084 sq. ft. Floor Plan',
    text: 'Dual private balconies (4\'0" and 5\'0"), living (12\'6"x10\'0"), dining, kitchen with utility, and master suite (13\'4"x10\'0") with private balcony.' },
  { type: '2 BHK', floor: '1st - 4th Floors', meta: 'Unit 003, Typical Level', area: '1125 sq. ft.', img: '/images/floor-plans/typical-unit-003.webp', w: 950, h: 680, alt: '2 BHK 1125 sq. ft. Floor Plan',
    text: 'Corner 2 BHK layout with dual 4\'6" wide balconies, expansive 16\'6" living room, cross-ventilation, and master suite with attached toilet.' },
  { type: '2 BHK', floor: '1st - 4th Floors', meta: 'Unit 002, Typical Level', area: '1183 sq. ft.', img: '/images/floor-plans/typical-unit-002.webp', w: 650, h: 960, alt: '2 BHK 1183 sq. ft. Floor Plan',
    text: 'Generous 2 BHK with double balconies, large living lounge, dining hall, kitchen with 4\'5" utility, and master bedroom with ensuite bath.' },
  { type: '3 BHK', floor: '1st - 4th Floors', meta: 'Unit 001, Typical Level', area: '1700 sq. ft.', img: '/images/floor-plans/typical-unit-001.webp', w: 620, h: 1100, alt: '3 BHK 1700 sq. ft. Floor Plan',
    text: 'Corner 3 BHK residence with 3 private balconies, 17\'0" living room, family dining, master suite (12\'0"x14\'0"), and 2 additional bedrooms.' },
  { type: '3 BHK', floor: 'Ground Floor', meta: 'Unit 002, Ground Level', area: '1718 sq. ft.', img: '/images/floor-plans/ground-unit-002.webp', w: 1020, h: 580, alt: '3 BHK 1718 sq. ft. Floor Plan',
    text: 'Largest residence in the development featuring expansive family spaces, 3 bedrooms, extensive utility area, and seamless ground floor accessibility.' },
];
---

<PageLayout
  title="Concept Design | Lotus Signature Residences, Floor Plans & Specifications"
  description="Explore Lotus Signature in Bendoorwell, Mangaluru: 22 luxury residences, 2 & 3 BHK configurations (1034 to 1718 sq. ft.), architectural exterior & interior galleries and specifications."
  currentPath="/concept-design"
>
  <PageHero
    crumb="Concept Design"
    logo={{ src: conceptStudio.logo, alt: `${conceptStudio.name} logo`, width: 292, height: 246 }}
    eyebrow={conceptStudio.name}
    title="Architecture & Interior Design."
    lead="The architecture and interior design studio behind Lotus Signature. Explore our residential apartments, villas, commercial and mixed-use work across Mangaluru and the region."
    facts={[
      { label: 'Projects in Portfolio', value: String(conceptProjects.length) },
      { label: 'Ongoing', value: String(ongoing) },
      { label: 'Completed Villas', value: String(completed) },
      { label: 'Disciplines', value: 'Architecture & Interiors' },
    ]}
    image={{ src: '/images/hero/hero-exterior.webp', alt: 'Lotus Signature - Complete Architectural Elevation at Dusk', width: 1720, height: 1450, pos: '0% 55%', zoom: 1.15, origin: '0% 55%' }}
    nav={[
      { href: '#overview', label: 'Overview' },
      { href: '#exterior-gallery', label: 'Exterior Gallery' },
      { href: '#interiors', label: 'Interior Spaces' },
      { href: '#configurations', label: 'Configurations' },
      { href: '#floor-plans', label: 'Floor Plans' },
      { href: '#specifications', label: 'Specifications' },
    ]}
  />

  <!-- Overview -->
  <section class="section tone-paper" id="overview">
    <div class="wrap">
      <SectionHeading
        eyebrow="Project overview"
        title="Architectural Blueprint & Key Facts."
        description="Designed as an exclusive low-density residential community where contemporary styling meets coastal micro-climatic intelligence."
      />
      <div class="factsheet">
        {factsheet.map((f) => (
          <div class="factsheet__item">
            <span class="tag">{f.label}</span>
            <h3 class="factsheet__title">{f.title}</h3>
            <p class="muted small">{f.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <ProjectGallery />
  <InteriorGallery />

  <!-- Configurations -->
  <section class="section tone-paper" id="configurations">
    <div class="wrap">
      <SectionHeading
        eyebrow="Residence configurations"
        title="Available 2 BHK & 3 BHK Layouts."
        description="Six accurately calculated saleable areas ranging from 1034 to 1718 sq. ft. Each configuration is planned with clear spatial zoning and wide private balconies."
      >
        <div class="tabs" role="group" aria-label="Filter layouts">
          <button type="button" class="active" data-filter="all" aria-pressed="true">All Units</button>
          <button type="button" data-filter="2 BHK" aria-pressed="false">2 BHK (4 Sizes)</button>
          <button type="button" data-filter="3 BHK" aria-pressed="false">3 BHK (2 Sizes)</button>
        </div>
      </SectionHeading>

      <div class="units" id="configs-container">
        {units.map((u) => (
          <article class="unit" data-type={u.type}>
            <a href="#explorer" class="frame frame--plate unit__plan" aria-label={`Inspect technical plan, ${u.alt}`}>
              <img src={u.img} alt={u.alt} width={u.w} height={u.h} loading="lazy" decoding="async" />
            </a>
            <div class="unit__head">
              <span class="tag">{u.type}</span>
              <span class="unit__floor">{u.floor}</span>
            </div>
            <p class="unit__area num">{u.area}</p>
            <p class="unit__meta">{u.meta}</p>
            <p class="muted small">{u.text}</p>
            <a href="#explorer" class="link unit__link">Inspect Technical Plan</a>
          </article>
        ))}
      </div>

      <div class="table-wrap">
        <table class="config-table">
          <caption class="visually-hidden">Summary of configurations</caption>
          <thead>
            <tr>
              <th scope="col">Configuration</th>
              <th scope="col">Unit No.</th>
              <th scope="col">Floor Level</th>
              <th scope="col">Saleable Area</th>
              <th scope="col"><span class="visually-hidden">Detailed Explorer</span></th>
            </tr>
          </thead>
          <tbody>
            {allApartmentConfigurations.map((item) => (
              <tr>
                <td>{item.type}</td>
                <td>Unit {item.unit}</td>
                <td class="muted">{item.level}</td>
                <td class="config-table__area num">{item.saleableArea}</td>
                <td class="config-table__action"><a href="#explorer" class="link">Explore Dimensions</a></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Floor plans -->
  <section class="section tone-mist" id="floor-plans">
    <div class="wrap">
      <SectionHeading
        eyebrow="Technical drawings & schematics"
        title="Interactive Floor Plan Explorer."
        description="Select any level and apartment unit below to inspect original brochure technical drawings, room dimensions, and saleable area breakdowns with high-resolution zoom."
      />
      <FloorPlanExplorer />
    </div>
  </section>

  <ProjectSpecifications />

  <CTASection
    eyebrow="Make your mark"
    title="Your Signature Residence in Bendoorwell."
    description="Speak directly with our senior booking directors to review available units, schedule a site walkthrough in Bendoorwell, or request technical documents."
    primaryCtaText="Register Your Enquiry"
    primaryCtaLink="/contact"
    secondaryCtaText="Contact Booking Desk"
    secondaryCtaLink="/contact#booking-contacts"
  />
</PageLayout>

<style>
  .factsheet { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid var(--rule); }
  .factsheet__item { padding: 1.75rem 2rem 2rem 0; border-bottom: 1px solid var(--rule); }
  .factsheet__item:not(:nth-child(3n + 1)) { padding-left: 2rem; border-left: 1px solid var(--rule); }
  .factsheet__title { font-size: 1.4rem; margin: 0.5rem 0 0.75rem; }

  .units { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 3rem clamp(1.5rem, 3vw, 2.5rem); }
  .unit { display: flex; flex-direction: column; }
  .unit__plan { display: block; aspect-ratio: 1 / 1; margin-bottom: 1.25rem; transition: border-color 0.3s var(--ease); }
  .unit__plan:hover { border-color: var(--rule-strong); }
  .unit__head { display: flex; justify-content: space-between; align-items: baseline; }
  .unit__floor { font-size: var(--fs-xs); color: var(--slate); }
  .unit__area { font-size: 2rem; line-height: 1.1; margin: 0.4rem 0 0.2rem; }
  .unit__meta { font-size: var(--fs-xs); color: var(--slate); margin-bottom: 0.9rem; }
  .unit__link { margin-top: auto; align-self: flex-start; }

  .table-wrap { position: relative; margin-top: clamp(3.5rem, 6vw, 5rem); overflow-x: auto; -webkit-overflow-scrolling: touch; }
  .config-table { min-width: 640px; font-size: var(--fs-sm); }
  .config-table th { text-align: left; font-weight: 450; font-size: var(--fs-xs); color: var(--slate); padding: 0 1rem 0.9rem 0; border-bottom: 1px solid var(--graphite); }
  .config-table td { padding: 1.1rem 1rem 1.1rem 0; border-bottom: 1px solid var(--rule); }
  .config-table__area { font-size: 1.25rem; }
  .config-table__action { text-align: right; }


  @media (max-width: 640px) {
    .config-table { min-width: 0; }
    .config-table thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
    .config-table, .config-table tbody { display: block; border-top: 1px solid var(--graphite); }
    .config-table tr { display: grid; grid-template-columns: auto 1fr auto; column-gap: 1rem; align-items: baseline; padding: 1rem 0; border-bottom: 1px solid var(--rule); }
    .config-table td { padding: 0; border: 0; }
    .config-table td:nth-child(1) { color: var(--lotus); font-size: var(--fs-xs); font-weight: 480; }
    .config-table td:nth-child(2) { font-size: var(--fs-sm); }
    .config-table td:nth-child(3) { grid-column: 1 / 3; font-size: var(--fs-xs); }
    .config-table td:nth-child(4) { grid-row: 1; grid-column: 3; }
    .config-table td:nth-child(5) { grid-column: 3; grid-row: 2; }
    .config-table__action .link { font-size: var(--fs-xs); }
  }
  @media (max-width: 960px) {
    .units { grid-template-columns: 1fr 1fr; }
    .factsheet { grid-template-columns: 1fr 1fr; }
    .factsheet__item:not(:nth-child(3n + 1)) { padding-left: 0; border-left: 0; }
    .factsheet__item:nth-child(even) { padding-left: 1.5rem; border-left: 1px solid var(--rule); }
  }
  @media (max-width: 640px) {
    .units, .factsheet { grid-template-columns: 1fr; }
    .factsheet__item:nth-child(even) { padding-left: 0; border-left: 0; }
  }
</style>

<script>
  function bindFilter(attr: string, itemSelector: string, match: (item: HTMLElement, value: string) => boolean) {
    const tabs = document.querySelectorAll<HTMLButtonElement>(`[${attr}]`);
    const items = document.querySelectorAll<HTMLElement>(itemSelector);
    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const value = tab.getAttribute(attr) || 'all';
        tabs.forEach((t) => {
          const on = t === tab;
          t.classList.toggle('active', on);
          t.setAttribute('aria-pressed', String(on));
        });
        items.forEach((item) => {
          item.hidden = !(value === 'all' || match(item, value));
        });
      });
    });
  }

  bindFilter('data-filter', '.unit', (el, v) => el.dataset.type === v);
</script>
