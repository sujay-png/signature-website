---
---

<section class="hero" id="hero" aria-labelledby="hero-title">
  <div class="hero__stage">
    <!-- Orbit lines -->
    <svg class="hero__orbit" viewBox="0 0 1000 1000" aria-hidden="true" preserveAspectRatio="xMidYMid meet">
      <circle cx="500" cy="500" r="430" />
      <circle cx="500" cy="500" r="330" class="hero__orbit-inner" />
    </svg>

    <p class="hero__wordmark" aria-hidden="true">
      <span class="hero__word hero__word--a">Lotus</span>
      <span class="hero__word hero__word--b">Signature</span>
    </p>

    <img
      class="hero__building"
      src="/images/hero/building-cutout.webp"
      alt="Lotus Signature - Architectural Exterior Elevation"
      width="661"
      height="572"
      fetchpriority="high"
      decoding="async"
    />

    <!-- Orbit markers -->
    <div class="hero__pin hero__pin--l" aria-hidden="true">
      <span class="hero__dot"></span>
      <span class="hero__pin-text"><em>2 &amp; 3 BHK</em><strong>Residences</strong></span>
    </div>
    <div class="hero__pin hero__pin--r" aria-hidden="true">
      <span class="hero__dot"></span>
      <span class="hero__pin-text"><em>Ground + 4</em><strong>Upper Floors</strong></span>
    </div>

    <!-- Glass card: residence -->
    <a href="/projects" class="glass hero__card hero__card--l">
      <span class="hero__card-title"><em>Explore The</em><strong>Residence</strong></span>
      <svg class="hero__card-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M7 17L17 7M9 7h8v8"/></svg>
      <span class="hero__card-img">
        <img src="/images/hero/hero-building.webp" alt="" width="830" height="800" decoding="async" />
      </span>
    </a>

    <!-- Glass card: facts -->
    <div class="glass hero__card hero__card--r">
      <p class="hero__stat"><span>22</span>Private Residences</p>
      <p class="hero__stat-sub">1034 to 1718 sq. ft., Bendoorwell, Mangaluru</p>
    </div>

    <a href="/contact" class="hero__cta"><span>Enquire<br />Now</span></a>
  </div>

  <div class="hero__foot wrap-wide">
    <p class="hero__tag"><strong>Make</strong> Your Mark.</p>
    <div class="hero__copy">
      <h1 class="hero__title" id="hero-title">An Address That Reflects Your Signature.</h1>
      <p class="hero__lead">
        A limited enclave of 22 boutique residences designed with generous proportions, natural light, and architectural grace in the heart of Bendoorwell, Mangaluru.
      </p>
    </div>
    <a href="#introduction" class="hero__scroll">Scroll to discover</a>
  </div>
</section>

<style>
  .hero {
    --blush: #f1e4ec;
    --blush-deep: #e5cfdc;
    position: relative; overflow: hidden; isolation: isolate;
    padding-top: var(--header-h);
    background:
      radial-gradient(60% 55% at 50% 58%, rgba(255, 255, 255, 0.95) 0%, rgba(255, 255, 255, 0) 70%),
      linear-gradient(180deg, var(--paper) 0%, var(--blush) 62%, var(--blush-deep) 100%);
  }

  .hero__stage {
    position: relative;
    height: clamp(560px, calc(100svh - var(--header-h) - 215px), 860px);
    max-width: 1680px; margin-inline: auto;
  }

  /* Giant wordmark, fading into the blush like the brochure swoosh */
  .hero__wordmark {
    position: absolute; z-index: 1; left: 0; right: 0; top: 3%;
    margin: 0; max-width: none; text-align: center;
    font-family: var(--font-display); line-height: 0.86; letter-spacing: -0.035em;
    font-size: clamp(4rem, 13.4vw, 15.5rem);
    white-space: nowrap; user-select: none;
  }
  .hero__word {
    display: inline-block;
    background: linear-gradient(180deg, var(--graphite) 0%, #4a3c47 46%, rgba(125, 33, 95, 0.0) 100%);
    -webkit-background-clip: text; background-clip: text; color: transparent;
    padding-bottom: 0.08em;
    animation: rise 1.3s var(--ease) both;
  }
  .hero__word--a { animation-delay: 0.1s; margin-right: 0.18em; }
  .hero__word--b { animation-delay: 0.22s; }

  .hero__building {
    position: absolute; z-index: 2; left: 50%; bottom: 0;
    width: min(44vw, 740px); height: auto;
    transform: translateX(-50%);
    filter: drop-shadow(0 40px 50px rgba(80, 40, 64, 0.18));
    animation: building-in 1.6s var(--ease) 0.25s both;
  }

  .hero__orbit {
    position: absolute; z-index: 0; left: 50%; top: 52%;
    width: min(78vw, 1160px); height: auto; transform: translate(-50%, -50%);
    fill: none; stroke: rgba(34, 37, 43, 0.14); stroke-width: 1;
    animation: fade 2s var(--ease) 0.5s both;
  }
  .hero__orbit-inner { stroke-dasharray: 2 6; stroke: rgba(156, 44, 120, 0.25); }

  .hero__pin { position: absolute; z-index: 3; display: grid; justify-items: center; gap: 0.5rem; text-align: center; animation: fade 1s var(--ease) 1s both; }
  .hero__pin--l { left: calc(50% - min(31vw, 460px)); top: 40%; }
  .hero__pin--r { left: calc(50% + min(27vw, 400px)); top: 36%; }
  .hero__dot { width: 22px; height: 22px; border-radius: 50%; border: 1px solid rgba(34,37,43,0.35); background: rgba(255,255,255,0.7); display: grid; place-items: center; }
  .hero__dot::after { content: ''; width: 6px; height: 6px; border-radius: 50%; background: var(--lotus); }
  .hero__pin-text { display: grid; font-size: var(--fs-sm); line-height: 1.3; }
  .hero__pin-text em { font-style: italic; font-weight: 300; color: var(--slate); }
  .hero__pin-text strong { font-weight: 500; }

  /* Frosted glass with chamfered corners */
  .glass {
    background: rgba(255, 255, 255, 0.42);
    backdrop-filter: blur(18px) saturate(1.3); -webkit-backdrop-filter: blur(18px) saturate(1.3);
    clip-path: polygon(18px 0, 100% 0, 100% calc(100% - 18px), calc(100% - 18px) 100%, 0 100%, 0 18px);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.7);
  }
  .hero__card { position: absolute; z-index: 3; bottom: 1.5rem; padding: 1.4rem 1.5rem; animation: rise 1.2s var(--ease) 0.9s both; }
  .hero__card--l { left: var(--gutter); width: 260px; display: grid; grid-template-columns: 1fr auto; gap: 1rem 0.5rem; transition: background-color 0.3s var(--ease); }
  .hero__card--l:hover { background: rgba(255, 255, 255, 0.7); }
  .hero__card-title { display: grid; font-size: 1.35rem; line-height: 1.2; }
  .hero__card-title em { font-style: italic; font-weight: 300; color: var(--slate); }
  .hero__card-title strong { font-family: var(--font-display); font-weight: 400; font-size: 1.6rem; }
  .hero__card-arrow { width: 20px; height: 20px; transition: transform 0.35s var(--ease); }
  .hero__card--l:hover .hero__card-arrow { transform: translate(3px, -3px); color: var(--lotus); }
  .hero__card-img { grid-column: 1 / -1; height: 132px; overflow: hidden; }
  .hero__card-img img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 40%; transition: transform 0.9s var(--ease); }
  .hero__card--l:hover .hero__card-img img { transform: scale(1.05); }

  .hero__card--r { right: var(--gutter); width: 300px; }
  .hero__stat { display: grid; font-size: var(--fs-sm); margin: 0; }
  .hero__stat span { font-family: var(--font-body); font-weight: 300; font-size: 4rem; line-height: 0.95; letter-spacing: -0.04em; }
  .hero__stat-sub { font-size: var(--fs-xs); color: var(--slate); margin: 0.35rem 0 0; }

  /* Round CTA sitting on the building's base */
  .hero__cta {
    position: absolute; z-index: 4; left: 50%; bottom: -10px; transform: translateX(-50%);
    width: 128px; height: 128px; border-radius: 50%;
    display: grid; place-items: center; text-align: center;
    background: var(--graphite); color: #fff;
    font-family: var(--font-display); font-size: 1.15rem; line-height: 1.15;
    box-shadow: 0 0 0 8px rgba(255, 255, 255, 0.55), 0 0 0 9px rgba(34, 37, 43, 0.12);
    transition: background-color 0.35s var(--ease), transform 0.5s var(--ease);
    animation: pop 1s var(--ease) 1.1s both;
  }
  .hero__cta:hover { background: var(--lotus); transform: translateX(-50%) scale(1.06); }

  .hero__foot {
    position: relative; z-index: 5;
    display: grid; grid-template-columns: 1fr minmax(0, 46rem) 1fr; align-items: end; gap: 2rem;
    padding-block: 2.25rem 2.25rem;
  }
  .hero__tag { margin: 0; font-size: 1.6rem; font-weight: 300; font-style: italic; }
  .hero__tag strong { font-style: normal; font-weight: 500; }
  .hero__copy { text-align: center; }
  .hero__title { font-size: clamp(1.75rem, 1.2rem + 1.6vw, 2.9rem); line-height: 1.12; margin-bottom: 0.9rem; }
  .hero__lead { font-size: var(--fs-sm); color: var(--slate); margin: 0 auto; max-width: 52ch; }
  .hero__scroll { justify-self: end; font-size: var(--fs-xs); color: var(--slate); writing-mode: vertical-rl; letter-spacing: 0.02em; padding-bottom: 0.25rem; }
  .hero__scroll:hover { color: var(--lotus); }

  @keyframes rise { from { opacity: 0; transform: translateY(40px); } to { opacity: 1; transform: none; } }
  @keyframes building-in { from { opacity: 0; transform: translate(-50%, 60px) scale(0.97); } to { opacity: 1; transform: translate(-50%, 0); } }
  @keyframes fade { from { opacity: 0; } to { opacity: 1; } }
  @keyframes pop { from { opacity: 0; transform: translateX(-50%) scale(0.6); } to { opacity: 1; transform: translateX(-50%) scale(1); } }

  /* Scroll-linked depth: wordmark drifts slower than the building */
  @supports (animation-timeline: scroll()) {
    .hero__wordmark { animation-name: drift; animation-timing-function: linear; animation-fill-mode: both; }
    .hero__stage .hero__wordmark { animation-timeline: scroll(root); animation-range: 0 90vh; }
    @keyframes drift { to { transform: translateY(18vh); opacity: 0.35; } }
  }

  @media (max-width: 1100px) {
    .hero__pin { display: none; }
    .hero__card--l { width: 220px; }
    .hero__card--r { width: 250px; }
    .hero__building { width: min(56vw, 640px); }
  }
  @media (max-width: 860px) {
    .hero__stage { height: auto; padding-top: 2rem; display: flex; flex-direction: column; align-items: center; }
    .hero__wordmark { position: relative; top: auto; font-size: 19vw; line-height: 0.9; white-space: normal; }
    .hero__word--a { margin-right: 0; display: block; }
    .hero__building { position: relative; left: auto; transform: none; width: 86vw; margin-top: -7vw; animation: fade 1.4s var(--ease) 0.25s both; }
    .hero__orbit { top: 50%; width: 130vw; }
    .hero__cta { position: relative; left: auto; bottom: auto; transform: none; margin-top: -54px; width: 108px; height: 108px; font-size: 1rem; animation: fade 1s var(--ease) 0.8s both; }
    .hero__cta:hover { transform: scale(1.05); }
    .hero__card { display: none; }
    .hero__foot { grid-template-columns: 1fr; text-align: left; }
    .hero__copy { text-align: left; }
    .hero__lead { margin: 0; }
    .hero__scroll { display: none; }
    .hero__tag { order: 2; font-size: 1.3rem; }
  }
  /* Tablets: keep the wordmark on one line so the headline stays near the fold */
  @media (min-width: 561px) and (max-width: 860px) {
    .hero__wordmark { font-size: 11.6vw; white-space: nowrap; }
    .hero__word--a { display: inline-block; margin-right: 0.18em; }
    .hero__building { width: 66vw; margin-top: -4vw; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__wordmark { animation: none; }
  }
</style>
