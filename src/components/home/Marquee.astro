---
const items = ['Make Your Mark', 'Bendoorwell, Mangaluru', '22 Private Residences', '2 & 3 BHK'];
const loop = [...items, ...items];
---

<section class="marquee" aria-label="Make Your Mark. Bendoorwell, Mangaluru. 22 Private Residences. 2 & 3 BHK.">
  <div class="marquee__track" aria-hidden="true">
    {[0, 1].map(() => (
      <ul class="marquee__group">
        {loop.map((t, i) => (
          <li class={i % 2 ? 'is-outline' : ''}>
            {t}
            <svg viewBox="0 0 40 24" class="marquee__lotus"><path d="M20 2c3 4 4 8 4 12s-2 7-4 8c-2-1-4-4-4-8s1-8 4-12zM9 8c3 1 6 4 7 8 .5 2 .5 4 0 6-3-1-6-3-7-6s-1-5 0-8zm22 0c1 3 1 5 0 8s-4 5-7 6c-.5-2-.5-4 0-6 1-4 4-7 7-8z" /></svg>
          </li>
        ))}
      </ul>
    ))}
  </div>
</section>

<style>
  .marquee {
    overflow: hidden; background: var(--paper);
    border-block: 1px solid var(--rule);
    padding-block: clamp(1.25rem, 2.5vw, 2rem);
  }
  .marquee__track { display: flex; width: max-content; animation: marquee 60s linear infinite; }
  .marquee:hover .marquee__track { animation-play-state: paused; }
  .marquee__group { display: flex; flex: none; }
  .marquee__group li {
    display: flex; align-items: center; gap: clamp(1.25rem, 3vw, 2.75rem);
    padding-right: clamp(1.25rem, 3vw, 2.75rem);
    font-family: var(--font-display); font-size: clamp(2.6rem, 1.5rem + 4.4vw, 6.5rem);
    line-height: 1.1; letter-spacing: -0.02em; white-space: nowrap; color: var(--graphite);
  }
  .marquee__group li.is-outline { color: transparent; -webkit-text-stroke: 1px var(--graphite); }
  .marquee__lotus { width: clamp(28px, 3vw, 46px); height: auto; fill: var(--lotus); flex: none; }
  @keyframes marquee { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) { .marquee__track { animation: none; } }
</style>
