---
interface Props {
  eyebrow?: string;
  title?: string;
  description?: string;
  primaryCtaText?: string;
  primaryCtaLink?: string;
  secondaryCtaText?: string;
  secondaryCtaLink?: string;
  class?: string;
}

const {
  eyebrow = 'An exclusive residential address',
  title = 'Your Next Chapter Begins Here.',
  description = 'Discover the spaces, thoughtful details and contemporary design that make Lotus Signature a distinctive residential address in Bendoorwell, Mangaluru.',
  primaryCtaText = 'Enquire Now',
  primaryCtaLink = '/contact',
  secondaryCtaText = 'Contact Our Team',
  secondaryCtaLink = '/contact#booking-contacts',
  class: className = '',
} = Astro.props;

const external = secondaryCtaLink.startsWith('http');
---

<section class={`cta section tone-mist ${className}`}>
  <div class="wrap">
    <div class="cta__inner grid-12">
      <p class="sec-head__label">{eyebrow}</p>
      <div class="cta__body">
        <h2 class="cta__title">{title}</h2>
        <p class="cta__desc">{description}</p>
        <div class="actions">
          <a href={primaryCtaLink} class="btn">{primaryCtaText}</a>
          <a
            href={secondaryCtaLink}
            class="btn btn--ghost"
            {...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
          >{secondaryCtaText}</a>
          <a
            href="https://wa.me/919986917368?text=Hello,%20I%20would%20like%20to%20enquire%20about%20Lotus%20Signature."
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn--wa"
          >
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.16-.17.2-.35.22-.64.08-.3-.15-1.26-.47-2.39-1.48-.88-.79-1.48-1.76-1.65-2.06-.17-.3-.02-.46.13-.6.13-.14.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.67-1.61-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.21 3.07c.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.7.63.71.22 1.36.19 1.87.12.57-.09 1.76-.72 2-1.41.25-.7.25-1.29.18-1.41-.08-.13-.27-.2-.57-.35M12.05 21.79h-.01a9.87 9.87 0 0 1-5.03-1.38l-.36-.21-3.74.98 1-3.65-.24-.37a9.86 9.86 0 0 1-1.51-5.26c0-5.45 4.44-9.88 9.89-9.88 2.64 0 5.12 1.03 6.99 2.9a9.83 9.83 0 0 1 2.89 6.99c0 5.45-4.44 9.88-9.88 9.88m8.41-18.3A11.82 11.82 0 0 0 12.05 0C5.5 0 .16 5.34.16 11.89c0 2.1.55 4.14 1.59 5.95L0 24l6.34-1.66a11.88 11.88 0 0 0 5.71 1.46h.01c6.55 0 11.89-5.34 11.89-11.89 0-3.18-1.24-6.17-3.48-8.41"/></svg>
            WhatsApp Sales
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .cta__inner { row-gap: 1.5rem; }
  .cta__body { grid-column: 4 / span 8; }
  .cta__title { font-size: var(--fs-xl); line-height: 1.08; }
  .cta__desc { font-size: var(--fs-md); font-weight: 340; color: var(--slate); margin: 1.25rem 0 2.25rem; max-width: 56ch; }
  @media (max-width: 860px) {
    .cta__body, .cta__inner .sec-head__label { grid-column: 1 / -1; }
    .cta__inner .sec-head__label { justify-self: start; }
  }
</style>
